@model List<GestionBibliotheque.Models.Livre>
<div style="overflow-x:auto;">
    <table style="width:100%;font-size:0.875rem;border-collapse:collapse;">
        <thead>
            <tr style="border-bottom:1px solid var(--border);background:rgba(0,0,0,0.01);">
                <th style="text-align:left;padding:0.75rem;font-weight:600;color:var(--text-muted);">Titre</th>
                <th style="text-align:left;padding:0.75rem;font-weight:600;color:var(--text-muted);">Auteur</th>
                <th style="text-align:left;padding:0.75rem;font-weight:600;color:var(--text-muted);">Stock</th>
                <th style="text-align:left;padding:0.75rem;font-weight:600;color:var(--text-muted);">Statut</th>
                <th style="text-align:center;padding:0.75rem;font-weight:600;color:var(--text-muted);">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var livre in Model)
            {
                var badgeBg    = livre.Statut == "disponible" ? "#dcfce7" : livre.Statut == "indisponible" ? "#fee2e2" : "#fef3c7";
                var badgeColor = livre.Statut == "disponible" ? "#166534" : livre.Statut == "indisponible" ? "#991b1b" : "#d97706";

                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:0.75rem;color:var(--text-dark);font-weight:500;max-width:220px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        @livre.Titre
                    </td>
                    <td style="padding:0.75rem;color:var(--text-mid);">@(livre.Auteur ?? "N/A")</td>
                    <td style="padding:0.75rem;color:var(--text-mid);">
                        <span style="font-weight:600;color:var(--text-dark);">@livre.QuantiteDisponible</span>
                        <span style="color:var(--text-muted);">/ @livre.QuantiteTotal</span>
                    </td>
                    <td style="padding:0.75rem;">
                        <span style="display:inline-block;background:@badgeBg;color:@badgeColor;padding:0.2rem 0.65rem;border-radius:999px;font-size:0.72rem;font-weight:700;letter-spacing:0.04em;">
                            @livre.Statut
                        </span>
                    </td>
                    <td style="padding:0.75rem;text-align:center;">
                        <div style="display:flex;gap:0.4rem;justify-content:center;">
                            <a asp-action="Details" asp-route-id="@livre.IdLivre"
                               style="width:30px;height:30px;background:#6b7280;color:white;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;"
                               title="Détails">
                                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </a>
                            <a asp-action="Edit" asp-route-id="@livre.IdLivre"
                               style="width:30px;height:30px;background:#3b82f6;color:white;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;"
                               title="Modifier">
                                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </a>
                            <button type="button" class="btn-delete" data-id="@livre.IdLivre"
                                    style="width:30px;height:30px;background:#ef4444;color:white;border:none;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;"
                                    title="Supprimer">
                                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
