@model GestionBibliotheque.ViewModels.MonAbonnementViewModel
@using GestionBibliotheque.Services
@{
    ViewData["Title"] = "Mon abonnement";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";

    var abo = Model.Abonnement;
    var attente = Model.DemandeEnAttente;
    var limites = PlanLimitesConfiguration.GetForTarif(abo?.IdTypeNavigation?.Tarif);
}

<div class="dash-hero">
    <div class="dash-welcome">
        <h1>Mon abonnement</h1>
        <p>Consultez votre statut, votre demande en cours et les limites de votre plan.</p>
    </div>
</div>

@if (attente != null)
{
    <div class="dash-card" style="margin-bottom:1rem; border-left:4px solid #f59e0b;">
        <div style="font-weight:800; color:var(--text-dark); margin-bottom:0.35rem;">
            Demande en attente
        </div>
        <div style="color:var(--text-muted);">
            Plan <strong>@(attente.IdTypeNavigation?.Libelle ?? "-")</strong> via <strong>@(attente.ModePaiement?.ToUpper() ?? "-")</strong>.
            L'admin doit valider votre demande pour l'activer.
        </div>
    </div>
}

@if (Model.EstActif && abo != null)
{
    <div class="dash-card" style="margin-bottom:1rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.75rem; margin-bottom:1rem;">
            <div>
                <div style="font-size:1.15rem; font-weight:800; color:var(--text-dark);">
                    @(abo.IdTypeNavigation?.Libelle ?? "Gratuit")
                </div>
                <div style="font-size:0.9rem; color:var(--text-muted);">Plan actuel</div>
            </div>
            <span style="font-size:0.78rem; font-weight:700; color:#15803d; background:#dcfce7; border:1px solid #86efac; padding:0.3rem 0.8rem; border-radius:999px;">
                Actif
            </span>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:0.75rem;">
            <div style="border:1px solid var(--border); border-radius:12px; padding:0.9rem; background:var(--bg);">
                <div style="font-size:0.7rem; font-weight:700; letter-spacing:0.08em; color:var(--text-muted);">DEBUT</div>
                <div style="margin-top:0.25rem; font-weight:800; color:var(--text-dark);">
                    @(abo.DateDebut?.ToString("dd MMM yyyy") ?? "-")
                </div>
            </div>
            <div style="border:1px solid var(--border); border-radius:12px; padding:0.9rem; background:var(--bg);">
                <div style="font-size:0.7rem; font-weight:700; letter-spacing:0.08em; color:var(--text-muted);">EXPIRATION</div>
                <div style="margin-top:0.25rem; font-weight:800; color:var(--text-dark);">
                    @(abo.DateFin?.ToString("dd MMM yyyy") ?? "Illimité")
                </div>
            </div>
            <div style="border:1px solid var(--border); border-radius:12px; padding:0.9rem; background:var(--bg);">
                <div style="font-size:0.7rem; font-weight:700; letter-spacing:0.08em; color:var(--text-muted);">MONTANT</div>
                <div style="margin-top:0.25rem; font-weight:800; color:var(--text-dark);">
                    @(abo.Montant > 0 ? $"{abo.Montant:0} FCFA" : "Gratuit")
                </div>
            </div>
            <div style="border:1px solid var(--border); border-radius:12px; padding:0.9rem; background:var(--bg);">
                <div style="font-size:0.7rem; font-weight:700; letter-spacing:0.08em; color:var(--text-muted);">PAIEMENT</div>
                <div style="margin-top:0.25rem; font-weight:800; color:var(--text-dark);">
                    @(abo.ModePaiement?.ToUpper() ?? "-")
                </div>
            </div>
        </div>

        <div style="margin-top:1rem; padding:0.9rem; border:1px solid var(--border); border-radius:12px; background:var(--bg);">
            <div style="font-size:0.78rem; font-weight:700; letter-spacing:0.06em; color:var(--text-muted); margin-bottom:0.6rem;">LIMITES DU PLAN</div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:0.5rem;">
                <div style="font-size:0.88rem; color:var(--text-dark);">📚 <strong>@limites.MaxEmpruntsSimultanes</strong> emprunt(s) simultané(s)</div>
                <div style="font-size:0.88rem; color:var(--text-dark);">🔖 <strong>@limites.MaxReservationsActives</strong> réservation(s) active(s)</div>
                <div style="font-size:0.88rem; color:var(--text-dark);">🔔 <strong>@limites.MaxAlertesActives</strong> alerte(s) active(s)</div>
                <div style="font-size:0.88rem; color:var(--text-dark);">📆 <strong>@limites.DureeEmpruntJours</strong> jours par emprunt</div>
            </div>
        </div>

        @if (attente == null)
        {
            <div style="margin-top:1rem;">
                <a asp-controller="Abonnement" asp-action="Souscrire" class="btn-sm-blue">
                    Renouveler ou changer de plan
                </a>
            </div>
        }
    </div>
}
else if (attente == null)
{
    <div class="dash-card">
        <div class="empty-state">
            <p>Vous n'avez pas d'abonnement actif.</p>
            <a asp-controller="Abonnement" asp-action="Souscrire" class="btn-sm-blue">
                Souscrire maintenant
            </a>
        </div>
    </div>
}
