<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lumina Bibliotheque</title>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>

    <nav class="navbar">
        <div class="nav-container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Lumina Bibliotheque</a>
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index" class="nav-link active">Accueil</a></li>
            </ul>
            <div class="nav-actions">
                <a asp-controller="Auth" asp-action="Login" class="btn-link">Connexion</a>
                <a asp-controller="Auth" asp-action="Inscription" class="btn-primary">S'inscrire</a>
            </div>
        </div>
    </nav>

    <main>
        @await Html.PartialAsync("_Alerts")
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-brand">
                <h3>Lumina Bibliotheque</h3>
                <p>L'alliance de l'autorité traditionnelle et de l'utilité numérique moderne.</p>
            </div>
            <div class="footer-links">
                <h4>LÉGAL</h4>
                <ul>
                    <li><a href="#">Confidentialité</a></li>
                    <li><a href="#">Conditions Générales</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 LUMINA BIBLIOTHEQUE. TOUS DROITS RÉSERVÉS.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
