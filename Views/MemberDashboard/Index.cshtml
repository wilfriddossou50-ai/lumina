@using GestionBibliotheque.Models
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";

    var emprunts = ViewBag.EmpruntsEnCours as List<Emprunt> ?? new();
    var reservations = ViewBag.Reservations as List<Reservation> ?? new();
    var positions = ViewBag.PositionsAttente as Dictionary<int, int> ?? new();
    var derniersLivres = ViewBag.DerniersLivres as List<Livre> ?? new();
    var livresEmpruntes = ViewBag.LivresEmpruntes as List<int> ?? new();
    var livresReserves = ViewBag.LivresReserves as List<int?> ?? new();
    var livresAlertes = ViewBag.LivresAlertes as List<int> ?? new();
    var today = DateOnly.FromDateTime(DateTime.Today);
    int retoursSemaine = ViewBag.RetoursASemaine ?? 0;
    int nbEmpruntsActifs = ViewBag.NbEmpruntsActifs ?? 0;
    int nbReservationsActives = ViewBag.NbReservationsActives ?? 0;
    int nbAlertesActives = ViewBag.NbAlertesActives ?? 0;
    string prenom = ViewBag.Prenom ?? "Lecteur";
}

<div class="member-dashboard-page">
    <form id="catalogueAntiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <section class="member-hero-shell">
        <div class="member-hero-copy">
            <span class="member-hero-tag">Espace membre</span>
            <h1>Bonjour, @prenom</h1>
            <p>Suivez vos emprunts, vos reservations et vos alertes en un coup d'oeil.</p>

            <div class="member-hero-stats">
                <div class="member-hero-stat">
                    <strong>@(ViewBag.AbonnementLibelle ?? "Gratuit")</strong>
                    <span>plan</span>
                </div>
                <div class="member-hero-stat">
                    <strong>@ViewBag.DureeEmprunt jours</strong>
                    <span>duree d'emprunt</span>
                </div>
                <div class="member-hero-stat">
                    <strong>@retoursSemaine</strong>
                    <span>retours a venir</span>
                </div>
            </div>
        </div>

        <div class="member-hero-side">
            <div class="member-plan-card">
                <strong>Capacite</strong>
                <span>@ViewBag.MaxEmprunts emprunts, @ViewBag.MaxReservations reservations, @ViewBag.MaxAlertes alertes.</span>
            </div>
            <div class="member-focus-card">
                <strong>Focus</strong>
                <span>
                    @(retoursSemaine > 0
                        ? $"Vous avez {retoursSemaine} retour(s) a anticiper."
                        : "Aucun retour urgent pour le moment.")
                </span>
            </div>
        </div>
    </section>

    <section class="member-kpi-grid">
        <article class="member-kpi-card">
            <label>EMPRUNTS</label>
            <strong>@nbEmpruntsActifs</strong>
            <span>en cours</span>
        </article>
        <article class="member-kpi-card">
            <label>RESERVATIONS</label>
            <strong>@nbReservationsActives</strong>
            <span>actives</span>
        </article>
        <article class="member-kpi-card">
            <label>ALERTES</label>
            <strong>@nbAlertesActives</strong>
            <span>actives</span>
        </article>
        <article class="member-kpi-card">
            <label>NOTIFICATIONS</label>
            <strong>@(ViewBag.NbNotifs ?? 0)</strong>
            <span>non lues</span>
        </article>
    </section>

    <section class="member-dashboard-grid">
        <article class="member-panel">
            <div class="member-panel-head">
                <div>
                    <h2>Emprunts en cours</h2>
                    <p>Les livres que vous avez actuellement.</p>
                </div>
                @if (emprunts.Any())
                {
                    <a asp-controller="Emprunt" asp-action="MesEmprunts" class="member-panel-link">Voir tout</a>
                }
            </div>

            @{
                var detailsAffiches = emprunts
                    .SelectMany(e => e.DetailEmprunts)
                    .Where(d => d.IdLivreNavigation != null)
                    .Take(4)
                    .ToList();
            }

            @if (!detailsAffiches.Any())
            {
                <div class="empty-state">
                    <p>Aucun emprunt en cours.</p>
                    <a asp-controller="Catalogue" asp-action="Index" class="catalog-btn">Explorer le catalogue</a>
                </div>
            }
            else
            {
                <div class="member-loan-list">
                    @foreach (var detail in detailsAffiches)
                    {
                        var livre = detail.IdLivreNavigation!;
                        var dateRetour = detail.DateRetourPrevu;
                        int joursRestants = dateRetour.HasValue ? dateRetour.Value.DayNumber - today.DayNumber : 0;
                        bool enRetard = dateRetour.HasValue && joursRestants < 0;
                        bool urgent = dateRetour.HasValue && !enRetard && joursRestants <= 3;
                        string css = enRetard ? "danger" : urgent ? "warn" : "ok";

                        <div class="member-loan-item">
                            <div class="member-book-spine">
                                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0118 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                                </svg>
                            </div>
                            <div class="member-book-meta">
                                <strong>@livre.Titre</strong>
                                <span>@(string.IsNullOrWhiteSpace(livre.Auteur) ? "Auteur inconnu" : livre.Auteur)</span>
                                @if (dateRetour.HasValue)
                                {
                                    <span>Retour le @dateRetour.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </div>
                            <div class="member-loan-status @css">
                                @(enRetard ? $"{Math.Abs(joursRestants)} j retard" : urgent ? "Bientot" : $"{joursRestants} jours")
                            </div>
                        </div>
                    }
                </div>
            }
        </article>

        <article class="member-panel">
            <div class="member-panel-head">
                <div>
                    <h2>Reservations</h2>
                    <p>Votre position sur les livres indisponibles.</p>
                </div>
            </div>

            @if (!reservations.Any())
            {
                <div class="empty-state">
                    <p>Aucune reservation active.</p>
                </div>
            }
            else
            {
                <div class="member-reservation-list">
                    @foreach (var res in reservations)
                    {
                        var livre = res.IdLivreNavigation;
                        int pos = positions.TryGetValue(res.IdReservation, out int p) ? p : 1;
                        bool prioritaire = pos == 1;

                        <div class="member-reservation-item">
                            <div class="member-book-spine">
                                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" />
                                </svg>
                            </div>
                            <div class="member-reservation-meta">
                                <strong>@(livre?.Titre ?? "Livre inconnu")</strong>
                                <span>@(prioritaire ? "En tete de file" : $"Position {pos}")</span>
                                <span>@(res.DateReservation.HasValue ? $"Demande le {res.DateReservation.Value:dd/MM/yyyy}" : "Date indisponible")</span>
                            </div>
                            <div class="member-pill @(prioritaire ? "ok" : "warn")">
                                @(prioritaire ? "Prioritaire" : "En attente")
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    </section>

    <section class="catalog-shell catalog-section">
        <div class="catalog-section-head">
            <h2>Recents</h2>
            <span>Les derniers livres vus dans votre parcours.</span>
        </div>

        @if (!derniersLivres.Any())
        {
            <div class="empty-state">
                <p>Aucun livre dans votre historique.</p>
            </div>
        }
        else
        {
            <div class="catalog-grid compact">
                @foreach (var livre in derniersLivres)
                {
                    @await Html.PartialAsync("~/Views/Catalogue/_LivreCard.cshtml", livre, new ViewDataDictionary(ViewData)
                    {
                        { "Emprunte", livresEmpruntes.Contains(livre.IdLivre) },
                        { "Reserve", livresReserves.Contains(livre.IdLivre) },
                        { "Alerte", livresAlertes.Contains(livre.IdLivre) }
                    })
                }
            </div>
        }
    </section>
</div>

<div id="actionModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:500;align-items:center;justify-content:center;">
    <div style="background:white;border-radius:var(--radius);padding:2rem;max-width:420px;width:90%;box-shadow:var(--shadow-md);">
        <h3 id="modalTitle" style="font-size:1.05rem;font-weight:700;margin-bottom:0.5rem;color:var(--text-dark);"></h3>
        <p id="modalMessage" style="font-size:0.875rem;color:var(--text-muted);margin-bottom:1.5rem;"></p>
        <div style="display:flex;gap:0.75rem;justify-content:flex-end;">
            <button onclick="closeModal()"
                    style="padding:0.6rem 1.25rem;background:#f1f5f9;color:var(--text-mid);border:none;border-radius:8px;font-weight:600;cursor:pointer;font-family:var(--font-sans);">
                Annuler
            </button>
            <button id="modalConfirmBtn"
                    style="padding:0.6rem 1.25rem;background:var(--blue);color:white;border:none;border-radius:8px;font-weight:600;cursor:pointer;font-family:var(--font-sans);">
                Confirmer
            </button>
        </div>
    </div>
</div>

<div id="toast" style="display:none;position:fixed;bottom:2rem;right:2rem;background:var(--navy);color:white;padding:0.875rem 1.5rem;border-radius:10px;font-size:0.875rem;font-weight:500;box-shadow:var(--shadow-md);z-index:600;max-width:360px;"></div>

@section Scripts {
<script>
const token = document.querySelector('#catalogueAntiForgeryForm input[name="__RequestVerificationToken"]')?.value ?? '';

function confirmerAction(action, idLivre, titreLivre) {
    const config = {
        emprunter: {
            title: 'Emprunter ce livre',
            message: `Vous allez emprunter "${titreLivre}".`,
            url: '/Catalogue/Emprunter',
            color: 'var(--blue)'
        },
        reserver: {
            title: 'Reserver ce livre',
            message: `Vous allez reserver "${titreLivre}".`,
            url: '/Catalogue/Reserver',
            color: '#8a4c1f'
        },
        alerte: {
            title: 'Notifier de la disponibilite',
            message: `Vous serez notifie quand "${titreLivre}" redeviendra disponible.`,
            url: '/Catalogue/CreerAlerte',
            color: '#1d4ed8'
        }
    };

    const c = config[action];
    document.getElementById('modalTitle').textContent = c.title;
    document.getElementById('modalMessage').textContent = c.message;
    document.getElementById('modalConfirmBtn').style.background = c.color;
    document.getElementById('modalConfirmBtn').onclick = () => executerAction(c.url, idLivre);
    document.getElementById('actionModal').style.display = 'flex';
}

function closeModal() {
    document.getElementById('actionModal').style.display = 'none';
}

async function executerAction(url, idLivre) {
    closeModal();
    const form = new FormData();
    form.append('idLivre', idLivre);
    form.append('__RequestVerificationToken', token);

    try {
        const res = await fetch(url, { method: 'POST', body: form });
        const data = await res.json();
        showToast(data.message, data.success);
        if (data.success) setTimeout(() => location.reload(), 1400);
    } catch {
        showToast('Une erreur est survenue.', false);
    }
}

function showToast(msg, success) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.background = success ? '#166534' : '#991b1b';
    t.style.display = 'block';
    setTimeout(() => t.style.display = 'none', 3000);
}

document.getElementById('actionModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});
</script>
}
