@model GestionBibliotheque.ViewModels.InscriptionViewModel
@{
    ViewData["Title"] = "Inscription";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="auth-back">
        <a asp-controller="Home" asp-action="Index">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Retour à l'accueil
        </a>
    </div>

    <div class="auth-card auth-card--wide">

        <!-- En-tête -->
        <div class="auth-header">
            <div class="auth-logo">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="white" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
                </svg>
            </div>
            <h1>Rejoindre Lumina</h1>
            <p>Commencez votre voyage intellectuel aujourd'hui</p>
        </div>

        <hr class="auth-divider" />

        <form asp-action="Inscription" asp-controller="Auth" method="post" id="registerForm">
            @Html.AntiForgeryToken()

            <!-- Prénom + Nom -->
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Prenom">PRÉNOM</label>
                    <input asp-for="Prenom" class="form-control" placeholder="Jean" />
                    <span asp-validation-for="Prenom" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Nom">NOM</label>
                    <input asp-for="Nom" class="form-control" placeholder="Dupont" />
                    <span asp-validation-for="Nom" class="field-error"></span>
                </div>
            </div>

            <!-- Sexe -->
            <div class="form-group">
                <label>SEXE</label>
                <div class="radio-group">
                    <label class="radio-label">
                        <input type="radio" asp-for="Sexe" value="Homme" /> Homme
                    </label>
                    <label class="radio-label">
                        <input type="radio" asp-for="Sexe" value="Femme" /> Femme
                    </label>
                    <label class="radio-label">
                        <input type="radio" asp-for="Sexe" value="Autre" /> Autre
                    </label>
                </div>
                <span asp-validation-for="Sexe" class="field-error"></span>
            </div>

            <!-- Téléphone + Email -->
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Telephone">TÉLÉPHONE</label>
                    <div class="input-icon-wrap">
                        <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                        </svg>
                        <input asp-for="Telephone" class="form-control has-icon" placeholder="01 23 45 67 89" />
                    </div>
                    <span asp-validation-for="Telephone" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Mail">EMAIL</label>
                    <div class="input-icon-wrap">
                        <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                        </svg>
                        <input asp-for="Mail" class="form-control has-icon" placeholder="jean.dupont@exemple.com" />
                    </div>
                    <span asp-validation-for="Mail" class="field-error"></span>
                </div>
            </div>

            <!-- Adresse -->
            <div class="form-group">
                <label asp-for="Adresse">ADRESSE COMPLÈTE</label>
                <div class="input-icon-wrap">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                    <input asp-for="Adresse" class="form-control has-icon" placeholder="123 Avenue de la Bibliothèque, 75000 Paris" />
                </div>
                <span asp-validation-for="Adresse" class="field-error"></span>
            </div>

            <!-- Identifiant + Mot de passe -->
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Login">IDENTIFIANT SOUHAITÉ</label>
                    <input asp-for="Login" class="form-control" placeholder="jdupont88" autocomplete="username" />
                    <span asp-validation-for="Login" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password">MOT DE PASSE</label>
                    <div class="input-icon-wrap">
                        <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                        </svg>
                        <input asp-for="Password" type="password" class="form-control has-icon has-icon-right"
                               placeholder="••••••••" id="passwordInput" autocomplete="new-password" />
                        <button type="button" class="toggle-password" onclick="togglePassword()">
                            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </button>
                    </div>
                    <!-- Barre de force -->
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill" id="strengthFill"></div>
                        </div>
                        <span class="strength-label" id="strengthLabel"></span>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
            </div>

            <!-- CGU -->
            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input asp-for="AccepterConditions" id="acceptTerms" type="checkbox" />
                    <span>
                        J'accepte les <a href="#" class="link-blue">conditions générales d'utilisation</a>
                        et la politique de confidentialité de Lumina Bibliotheque.
                    </span>
                </label>
                <span asp-validation-for="AccepterConditions" class="field-error"></span>
            </div>

            <!-- Bouton -->
            <button id="submitButton" type="submit" class="btn-submit" disabled>Créer mon compte</button>
        </form>

        <!-- Lien connexion -->
        <div class="auth-footer">
            Déjà membre ? <a asp-controller="Auth" asp-action="Login" class="link-blue">Se connecter</a>
        </div>
    </div>

    <!-- Footer bas de page -->
    <div class="auth-page-footer">
        <span>© 2024 Lumina Bibliotheque. All rights reserved.</span>
        <div class="auth-page-footer-links">
            <a href="#">Aide</a>
            <a href="#">Contact</a>
            <a href="#">Français (FR)</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Toggle mot de passe
    function togglePassword() {
        const input = document.getElementById('passwordInput');
        const eyeIcon = document.getElementById('eyeIcon');
        input.type = input.type === 'password' ? 'text' : 'password';
        eyeIcon.innerHTML = input.type === 'password'
            ? '<path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />'
            : '<path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223a9.005 9.005 0 0116.04 0M2.248 12a10.97 10.97 0 001.43 3.45m3.61 3.4A9.958 9.958 0 0012 19.5a9.96 9.96 0 005.829-1.628m3.497-3.22a10.967 10.967 0 00.428-1.302" />';
    }

    // Activer le bouton après validation des conditions
    function updateSubmitState() {
        const checkbox = document.getElementById('acceptTerms');
        const submitBtn = document.getElementById('submitButton');
        if (!submitBtn) return;
        submitBtn.disabled = !checkbox.checked;
    }

    document.addEventListener('DOMContentLoaded', function () {
        const checkbox = document.getElementById('acceptTerms');
        if (!checkbox) return;
        checkbox.addEventListener('change', updateSubmitState);
        updateSubmitState();

        document.getElementById('passwordInput')?.addEventListener('input', function () {
            const val = this.value;
            const fill = document.getElementById('strengthFill');
            const label = document.getElementById('strengthLabel');
            let score = 0;
            if (val.length >= 6) score++;
            if (val.length >= 10) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const levels = [
                { pct: '20%', color: '#ef4444', text: 'Très faible' },
                { pct: '40%', color: '#f97316', text: 'Faible' },
                { pct: '60%', color: '#eab308', text: 'Moyen' },
                { pct: '80%', color: '#3b82f6', text: 'Robuste' },
                { pct: '100%', color: '#22c55e', text: 'Excellent' },
            ];
            if (val.length === 0) {
                fill.style.width = '0';
                label.textContent = '';
                return;
            }
            const lvl = levels[Math.min(score, 4)];
            fill.style.width = lvl.pct;
            fill.style.background = lvl.color;
            label.textContent = 'Force du mot de passe : ' + lvl.text;
            label.style.color = lvl.color;
        });
    });
</script>
}
