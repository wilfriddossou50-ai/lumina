@model GestionBibliotheque.ViewModels.SouscriptionAbonnementViewModel
@using GestionBibliotheque.Services
@{
    ViewData["Title"] = "Souscrire";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<div class="dash-hero">
    <div class="dash-welcome">
        <h1>S'abonner</h1>
        <p>Choisissez un plan pour demander une activation ou un renouvellement.</p>
    </div>
</div>

@if (Model.EnAttente)
{
    <div class="dash-card">
        <div style="text-align:center; padding:1.5rem 0;">
            <div style="font-size:2rem; margin-bottom:0.5rem;">⏳</div>
            <div style="font-weight:800; font-size:1.05rem; color:var(--text-dark); margin-bottom:0.4rem;">
                Demande en attente de validation
            </div>
            <div style="color:var(--text-muted); font-size:0.9rem; margin-bottom:1rem;">
                Votre demande est en cours de traitement par l'administrateur. Vous serez notifié après validation.
            </div>
            <a asp-controller="Abonnement" asp-action="MonAbonnement" class="btn-sm-blue">
                Voir mon abonnement
            </a>
        </div>
    </div>
}
else if (Model.Plans == null || !Model.Plans.Any())
{
    <div class="dash-card">
        <div class="empty-state">
            <p>Aucun plan d'abonnement n'est disponible pour le moment.</p>
        </div>
    </div>
}
else
{
    <div class="dash-card" style="margin-bottom:1rem;">
        <div style="font-weight:800; color:var(--text-dark); margin-bottom:0.3rem;">
            Moyen de paiement
        </div>
        <div style="color:var(--text-muted); font-size:0.9rem; margin-bottom:0.75rem;">
            Choisissez votre moyen de paiement. L'abonnement sera activé après validation admin.
        </div>
        <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
            @foreach (var m in Model.MethodesPaiement)
            {
                <label style="display:flex; align-items:center; gap:0.45rem; padding:0.5rem 0.9rem; border:1px solid var(--border); border-radius:999px; background:var(--white); cursor:pointer;">
                    <input type="radio" name="globalModePaiement" value="@m.Value" @(m.Value == "mtn" ? "checked" : "") />
                    <span style="font-size:0.9rem; color:var(--text-dark); font-weight:700;">@m.Label</span>
                </label>
            }
        </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1rem;">
        @foreach (var plan in Model.Plans)
        {
            bool estPlanActuel = Model.EstActif && Model.AbonnementActuel?.IdType == plan.IdType;
            var limitesPlan = PlanLimitesConfiguration.GetForTarif(plan.Tarif);

            <div style="border:1px solid @(estPlanActuel ? "#3b82f6" : "var(--border)"); border-radius:var(--radius); padding:1rem; background:var(--white); box-shadow:var(--shadow); position:relative;">
                @if (estPlanActuel)
                {
                    <span style="position:absolute; top:0.75rem; right:0.75rem; font-size:0.7rem; font-weight:700; color:#1d4ed8; background:#eff6ff; border:1px solid #bfdbfe; padding:0.2rem 0.6rem; border-radius:999px;">
                        Actuel
                    </span>
                }

                <div style="font-weight:800; color:var(--text-dark); font-size:1.05rem; margin-bottom:0.2rem;">@plan.Libelle</div>
                <div style="color:var(--text-muted); font-size:0.9rem; margin-bottom:1rem;">
                    @if (!plan.Tarif.HasValue) { <span>Tarif non défini</span> }
                    else if (plan.Tarif.Value <= 0) { <span>Gratuit - illimité</span> }
                    else if (Math.Abs(plan.Tarif.Value - 5000) < 0.5f) { <span>5 000 FCFA - 1 an</span> }
                    else { <span>@($"{plan.Tarif:0} FCFA") - 30 jours</span> }
                </div>

                <div style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem; display:grid; gap:0.3rem;">
                    <div>📚 @limitesPlan.MaxEmpruntsSimultanes emprunt(s) simultané(s)</div>
                    <div>🔖 @limitesPlan.MaxReservationsActives réservation(s) active(s)</div>
                    <div>🔔 @limitesPlan.MaxAlertesActives alerte(s) active(s)</div>
                    <div>📆 @limitesPlan.DureeEmpruntJours jours par emprunt</div>
                </div>

                @if (plan.Tarif.HasValue)
                {
                    <form asp-controller="Abonnement" asp-action="Souscrire" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="IdType" value="@plan.IdType" />
                        <input type="hidden" name="ModePaiement" value="mtn" />
                        <button type="submit" class="btn-dark w-full">
                            @(estPlanActuel ? "Renouveler" : "Choisir ce plan")
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn-dark w-full" disabled>Non disponible</button>
                }
            </div>
        }
    </div>

    <script>
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', () => {
                const sel = document.querySelector('input[name="globalModePaiement"]:checked');
                if (!sel) return;
                const h = form.querySelector('input[name="ModePaiement"]');
                if (h) h.value = sel.value;
            });
        });
    </script>
}
