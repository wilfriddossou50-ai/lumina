@model GestionBibliotheque.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-back">
        <a asp-controller="Home" asp-action="Index">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Retour à l'accueil
        </a>
    </div>

    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-logo">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="white" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
                </svg>
            </div>
            <h1>Connexion à Lumina</h1>
            <p>Accédez à votre espace membre</p>
        </div>
        <hr class="auth-divider" />
        <form asp-action="Login" asp-controller="Auth" method="post" id="loginForm">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Login">IDENTIFIANT</label>
                <input asp-for="Login" class="form-control" placeholder="Votre identifiant" autocomplete="username" />
                <span asp-validation-for="Login" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password">MOT DE PASSE</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input asp-for="RememberMe" type="checkbox" />
                    <span>Se souvenir de moi</span>
                </label>
            </div>
            <button type="submit" class="btn-submit">Se connecter</button>
        </form>
        <div class="auth-footer">
            Pas encore de compte ? <a asp-controller="Auth" asp-action="Inscription" class="link-blue">Créer un compte</a>
        </div>
    </div>
    <div class="auth-page-footer">
        <span>© 2024 Lumina Bibliotheque. All rights reserved.</span>
        <div class="auth-page-footer-links">
            <a href="#">Aide</a>
            <a href="#">Contact</a>
            <a href="#">Français (FR)</a>
        </div>
    </div>
</div>
