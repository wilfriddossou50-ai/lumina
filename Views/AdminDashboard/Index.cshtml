@model GestionBibliotheque.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["ActivePage"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <section class="dashboard-hero reveal">
        <div class="hero-copy">
            <span class="eyebrow">Administration Lumina</span>
            <h1>Tableau de bord executif</h1>
            <p>
                Un cockpit plus clair pour suivre l'activite, la tension sur le catalogue
                et les priorites operationnelles de la semaine.
            </p>

            <div class="hero-badges">
                <span class="hero-badge">
                    <strong>@Model.NiveauService</strong>
                    niveau de service
                </span>
                <span class="hero-badge">
                    <strong>@Model.NouveauxMembresCeMois</strong>
                    nouveaux membres ce mois
                </span>
                <span class="hero-badge">
                    <strong>@Model.RetoursPrevusCetteSemaine</strong>
                    retours attendus cette semaine
                </span>
            </div>
        </div>

        <div class="hero-side">
            <div class="hero-date">Vue generale - @DateTime.Now.ToString("dd MMMM yyyy")</div>
            <a asp-controller="Catalogue" asp-action="Create" class="admin-cta">
                <span data-lucide="book-plus"></span>
                Nouveau livre
            </a>

            <div class="hero-highlight">
                <div class="hero-highlight-label">Message de pilotage</div>
                <p>@Model.MessagePilotage</p>
            </div>
        </div>
    </section>

    <section class="kpi-grid">
        <article class="kpi-card reveal">
            <div class="kpi-icon blue">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0118 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">EXEMPLAIRES</span>
                <div class="kpi-value" data-count="@Model.TotalExemplaires">@Model.TotalExemplaires</div>
                <div class="kpi-sub">@Model.TotalLivres titres dans le catalogue</div>
            </div>
        </article>

        <article class="kpi-card reveal">
            <div class="kpi-icon cyan">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-1.03M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9zm0 0v.01M12 6a3 3 0 100 6 3 3 0 000-6z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">MEMBRES</span>
                <div class="kpi-value" data-count="@Model.TotalMembres">@Model.TotalMembres</div>
                <div class="kpi-sub">@Model.NouveauxMembresCeMois nouvelles inscriptions ce mois</div>
            </div>
        </article>

        <article class="kpi-card reveal">
            <div class="kpi-icon amber">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label">EMPRUNTS</span>
                <div class="kpi-value" data-count="@Model.TotalEmpruntsEnCours">@Model.TotalEmpruntsEnCours</div>
                <div class="kpi-sub">@Model.EmpruntsCetteSemaine demarres sur 7 jours</div>
            </div>
        </article>

        <article class="kpi-card reveal">
            <div class="kpi-icon red">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86l-8.02 13.9A2.25 2.25 0 004.22 21h15.56a2.25 2.25 0 001.95-3.34l-8.02-13.9a2.25 2.25 0 00-3.9 0z" />
                </svg>
            </div>
            <div class="kpi-content">
                <span class="kpi-label danger">RETARDS</span>
                <div class="kpi-value danger" data-count="@Model.TotalRetards">@Model.TotalRetards</div>
                <div class="kpi-sub">@Model.TauxRetard% du stock emprunte</div>
            </div>
        </article>
    </section>

    <section class="dashboard-grid dashboard-grid-top">
        <article class="dashboard-card reveal">
            <div class="panel-header">
                <div>
                    <h2>Disponibilite du stock</h2>
                    <p>Vue synthetique de la capacite immediate du catalogue.</p>
                </div>
                <span class="panel-chip neutral">@Model.TauxDisponibilite% disponible</span>
            </div>

            <div class="radial-wrap">
                <div class="radial-meter" style="--value:@Model.TauxDisponibilite;">
                    <div class="radial-inner">
                        <strong>@Model.TauxDisponibilite%</strong>
                        <span>disponibilite</span>
                    </div>
                </div>

                <div class="metric-list">
                    <div class="metric-row">
                        <span>Exemplaires disponibles</span>
                        <strong>@Model.LivresDisponibles</strong>
                    </div>
                    <div class="metric-row">
                        <span>Exemplaires mobilises</span>
                        <strong>@(Model.TotalExemplaires - Model.LivresDisponibles)</strong>
                    </div>
                    <div class="metric-row">
                        <span>Livres indisponibles</span>
                        <strong>@Model.LivresIndisponibles</strong>
                    </div>
                    <div class="metric-row">
                        <span>Reservations en attente</span>
                        <strong>@Model.TotalReservations</strong>
                    </div>
                </div>
            </div>
        </article>

        <article class="dashboard-card reveal">
            <div class="panel-header">
                <div>
                    <h2>Resume operationnel</h2>
                    <p>Les indicateurs les plus utiles pour suivre la semaine en cours.</p>
                </div>
                <span class="panel-chip">@Model.EmpruntsCetteSemaine prets</span>
            </div>

            <div class="metric-list summary-list">
                <div class="metric-row emphasis">
                    <span>Emprunts enregistres cette semaine</span>
                    <strong>@Model.EmpruntsCetteSemaine</strong>
                </div>
                <div class="metric-row">
                    <span>Retours prevus cette semaine</span>
                    <strong>@Model.RetoursPrevusCetteSemaine</strong>
                </div>
                <div class="metric-row">
                    <span>Taux d'occupation du stock</span>
                    <strong>@Model.TauxOccupation%</strong>
                </div>
                <div class="metric-row">
                    <span>Taux de reservation</span>
                    <strong>@Model.TauxReservation%</strong>
                </div>
            </div>
        </article>
    </section>

    <section class="dashboard-grid dashboard-grid-bottom">
        <article class="dashboard-card reveal">
            <div class="panel-header">
                <div>
                    <h2>Repartition du catalogue</h2>
                    <p>Categories les plus representees dans le catalogue.</p>
                </div>
            </div>

            @if (Model.CategoriesPopulaires.Any())
            {
                <div class="distribution-list">
                    @foreach (var categorie in Model.CategoriesPopulaires)
                    {
                        <div class="distribution-item">
                            <div class="distribution-head">
                                <span>@categorie.Label</span>
                                <strong>@categorie.Value livres</strong>
                            </div>
                            <div class="distribution-track">
                                <div class="distribution-fill" style="--fill-width:@Math.Max(categorie.Percentage, 6)%"></div>
                            </div>
                            <div class="distribution-meta">@categorie.Percentage% du catalogue</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state compact">
                    <div class="empty-icon">
                        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 21a8.25 8.25 0 01-15 0M4.5 3h15v12h-15V3z" />
                        </svg>
                    </div>
                    <h3>Aucune categorie disponible</h3>
                    <p>Ajoute quelques livres categorises pour obtenir une meilleure lecture du fonds.</p>
                </div>
            }
        </article>

        <article class="dashboard-card priorities-card reveal">
            <div class="panel-header">
                <div>
                    <h2>Priorites du jour</h2>
                    <p>Les sujets qui demandent une action rapide.</p>
                </div>
            </div>

            <div class="priority-list">
                <a asp-controller="Emprunt" asp-action="Index" class="priority-item">
                    <div class="priority-badge alert">@Model.TotalRetards</div>
                    <div>
                        <h3>Retards a relancer</h3>
                        <p>Reduire la pression sur le stock et les penalites.</p>
                    </div>
                </a>

                <a asp-controller="Reservation" asp-action="Index" class="priority-item">
                    <div class="priority-badge info">@Model.TotalReservations</div>
                    <div>
                        <h3>Reservations a traiter</h3>
                        <p>Donner de la visibilite aux membres en attente.</p>
                    </div>
                </a>

                <a asp-controller="Catalogue" asp-action="Index" class="priority-item">
                    <div class="priority-badge warning">@Model.LivresIndisponibles</div>
                    <div>
                        <h3>Ouvrages indisponibles</h3>
                        <p>Identifier les references les plus tendues du catalogue.</p>
                    </div>
                </a>

                <a asp-controller="Notification" asp-action="Index" class="priority-item">
                    <div class="priority-badge dark">@Model.NbNotificationsNonLues</div>
                    <div>
                        <h3>Notifications non lues</h3>
                        <p>Garder le suivi administratif propre et reactif.</p>
                    </div>
                </a>
            </div>
        </article>
    </section>

    <section class="quick-grid">
        <a asp-controller="Catalogue" asp-action="Index" class="quick-card reveal">
            <div class="quick-icon">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" />
                </svg>
            </div>
            <div>
                <div class="quick-title">Catalogue</div>
                <div class="quick-sub">Gerer les ouvrages et leur disponibilite</div>
            </div>
        </a>

        <a asp-controller="Membre" asp-action="Index" class="quick-card reveal">
            <div class="quick-icon">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 20a6 6 0 00-12 0m12 0H6m12 0h1.5m-15 0H3m9-12a4 4 0 110-8 4 4 0 010 8z" />
                </svg>
            </div>
            <div>
                <div class="quick-title">Membres</div>
                <div class="quick-sub">Suivre la base des membres et leurs profils</div>
            </div>
        </a>

        <a asp-controller="Emprunt" asp-action="Index" class="quick-card reveal">
            <div class="quick-icon">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75" />
                </svg>
            </div>
            <div>
                <div class="quick-title">Emprunts</div>
                <div class="quick-sub">Piloter les prets, retours et relances</div>
            </div>
        </a>
    </section>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-count]').forEach((element, index) => {
            const target = Number(element.getAttribute('data-count') || '0');
            const duration = 900;
            const startDelay = index * 120;
            const start = performance.now() + startDelay;

            function animate(now) {
                if (now < start) {
                    requestAnimationFrame(animate);
                    return;
                }

                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                element.textContent = Math.round(target * eased).toString();

                if (progress < 1) {
                    requestAnimationFrame(animate);
                }
            }

            requestAnimationFrame(animate);
        });
    </script>
}
